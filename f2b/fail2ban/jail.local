[DEFAULT]
ignoreip = 127.0.0.1/8 ::1 __F2B_IGNORE_IPS__
banaction = iptables-multiport
banaction_allports = iptables-allports

[sshd]
enabled  = true

# WordPress login brute-force protection from host-mounted proxy access logs.
[caddy-wp]
enabled  = true
filter   = caddy-wp
logpath  = __PROXY_LOG_DIR__/wp-staging-access.log
		   __PROXY_LOG_DIR__/wp-dev-access.log
maxretry = 10
findtime = 600
bantime  = 3600
