    @health path /_healthz
    respond @health "ok:abcwpdev" 200

    @login_alias_dev path /abcnorio-login
    rewrite @login_alias_dev /wp/wp-login.php

    @wp_login_get_dev_with_query `path('/wp/wp-login.php') && method('GET') && {query} != ''`
    redir @wp_login_get_dev_with_query /abcnorio-login?{query} 302

    @wp_login_get_dev_no_query `path('/wp/wp-login.php') && method('GET') && {query} == ''`
    redir @wp_login_get_dev_no_query /abcnorio-login 302

    reverse_proxy wp_dev:80
}

