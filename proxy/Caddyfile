# Static Site - dev (SSR via Astro dev server for instant previews)
{$DOMAIN_DEV} {
    @health path /_healthz
    respond @health "ok:dev" 200

    reverse_proxy astro:3033
}

# Static Site - staging
{$DOMAIN_STAGING} {
    @health path /_healthz
    respond @health "ok:staging" 200

    reverse_proxy astro-staging:3033
}

# Static Site - preview
{$DOMAIN_PREVIEW} {
    @health path /_healthz
    respond @health "ok:preview" 200

    @search path /search/api /search/api/*
    reverse_proxy @search astro-staging:3033

    reverse_proxy web:80
}

