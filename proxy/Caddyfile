# Static Site - web
abcnorio.itztlacoliuhqui.org {
    @health path /_healthz
    respond @health "ok:abcnorio" 200

    @search path /search/api /search/api/*
    reverse_proxy @search astro:3033

    reverse_proxy web:80
}

# Wordpress - staging
abcwp.itztlacoliuhqui.org {
    @blocked_ips {
        remote_ip 140.213.5.0/24 # this ip tried to hack our service!
    }
    respond @blocked_ips 403

    @health path /_healthz
    respond @health "ok:abcwp" 200

    @login_alias_stg path /abcnorio-login
    rewrite @login_alias_stg /wp/wp-login.php

    @wp_login_get_stg_with_query `path('/wp/wp-login.php') && method('GET') && {query} != ''`
    redir @wp_login_get_stg_with_query /abcnorio-login?{query} 302

    @wp_login_get_stg_no_query `path('/wp/wp-login.php') && method('GET') && {query} == ''`
    redir @wp_login_get_stg_no_query /abcnorio-login 302

    reverse_proxy wp_staging:80
}

# Wordpress - dev
abcwpdev.itztlacoliuhqui.org {
    @blocked_ips {
        remote_ip 140.213.5.0/24 # this ip tried to hack our service!
    }
