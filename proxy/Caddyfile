{
    servers {
        protocols h1 h2
    }
}

localhost {
    respond "Hello, World. I don't believe this but it works"
}

# Static Site - web
{$DOMAIN_PRODUCTION} {
    @health path /_healthz
    respond @health "ok:abcnorio" 200
    # fallback to avoid issues when the production ssr components aren't running.
    @ssr path /events/listing /events/listing/* /articles/listing /articles/listing/* /search/api /search/api/*
    reverse_proxy @ssr astro-prod:3033 {
        # Pool up to 32 idle keepalive connections to astro-prod.
        # Without this, each request tears down and re-establishes a TCP connection —
        # this results in connection drops load tests.
        transport http {
            keepalive 30s
            keepalive_idle_conns 64
        }
        @down status 502 503 504
        handle_response @down {
            respond `<p class="listing-unavailable">Filtering is temporarily unavailable. <a href="/events/">View all events</a></p>` 503
        }
    }

    handle_errors {
        @ssr_errors path /events/listing /events/listing/* /articles/listing /articles/listing/* /search/api /search/api/*
        @ssr_proxy_down expression `{http.error.status_code} in [502, 503, 504]`

        handle @ssr_errors {
            handle @ssr_proxy_down {
                respond `<p class="listing-unavailable">Filtering is temporarily unavailable. <a href="/events/">View all events</a></p>` 503
            }
        }
    }

    reverse_proxy web:80
}

# Wordpress - staging
{$DOMAIN_WP_STAGING} {
    @blocked_ips {
        remote_ip 140.213.5.0/24 # this ip tried to hack our service!
    }
    respond @blocked_ips 403

    @health path /_healthz
    respond @health "ok:abcwp" 200

    @login_alias_stg path /abcnorio-login
    rewrite @login_alias_stg /wp/wp-login.php

    @wp_login_get_stg_with_query `path('/wp/wp-login.php') && method('GET') && {query} != ''`
    redir @wp_login_get_stg_with_query /abcnorio-login?{query} 302

    @wp_login_get_stg_no_query `path('/wp/wp-login.php') && method('GET') && {query} == ''`
    redir @wp_login_get_stg_no_query /abcnorio-login 302

    # serve uploads from web (static copy) instead of abcwpstaging — production independence
    @wp_uploads path /app/uploads/*
    reverse_proxy @wp_uploads web:80

    reverse_proxy abcwpstaging:80

    log {
        format json
        output file /var/log/caddy/wp-staging-access.log
    }
}

