{
	servers {
		trusted_proxies static private_ranges
	}
}

(cache_headers) {
        @vendor path /vendor/*
        header @vendor Cache-Control "public, max-age=2592000"

        @static path /favicon/* /images/* /robots.txt /site.webmanifest
        header @static Cache-Control "public, max-age=31536000"

        @static_img path_regexp \.(webp|avif|jpg|jpeg|png|gif|svg|ico|woff2|woff)$
        header @static_img Cache-Control "public, max-age=31536000"

        # Must be last — overrides @static_img for /_astro/* to preserve immutable
        @hashed path /_astro/*
        header @hashed Cache-Control "public, max-age=31536000, immutable"
}

:80 {
	@prod host {$DOMAIN_PRODUCTION}
	@dev host {$DOMAIN_DEV}
	@staging host {$DOMAIN_STAGING}
	@preview host {$DOMAIN_PREVIEW}

	handle @prod {
		root /srv/prod/client/
		file_server
		templates
		encode zstd gzip
                import cache_headers
        }

        handle @dev {
                root /srv/dev/client/
                file_server
                templates
                encode zstd gzip
                import cache_headers
        }

        handle @staging {
                root /srv/staging/client/
                file_server
                templates
                encode zstd gzip
                import cache_headers
        }

        handle @preview {
                root /srv/preview/client/
                file_server
                templates
                encode zstd gzip
                import cache_headers
        }

        @docs host {$DOMAIN_DOCS}
        handle @docs {
                root /srv/docs/
                file_server
                encode zstd gzip
                import cache_headers
	}

        # for serving uploads from static server on WP domains
        @wp_uploads host {$DOMAIN_WP_STAGING}
        @wp_uploads path /app/uploads/*
        handle @wp_uploads {
                uri strip_prefix /app/uploads
                root * /srv/uploads/
                import cache_headers
                file_server
        }

}