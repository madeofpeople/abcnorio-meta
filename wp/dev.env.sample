# ░░ Sample env sample variables for dev cms ░░
# ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
#                                    
# Environment-specific settings for abcwpdev
# Shared settings (SERVER_NAME, DB_HOST, DB_USER/PASSWORD, TTL, CADDY_ROOT, DEBUG, WP_POST_REVISIONS, save-trigger queue flag and trigger URL) are in runtime.env
DB_NAME=your-dev-db-name
WP_ENV=development
WP_SAVE_TRIGGER_TARGET=dev
WP_HOME=https://your-wp-dev-domain.example
WP_SITEURL=https://your-wp-dev-domain.example/wp

# WP salts — dev-specific
# Generate from https://roots.io/salts.html or https://api.wordpress.org/secret-key/1.1/salt/
AUTH_KEY=generate-me
SECURE_AUTH_KEY=generate-me
LOGGED_IN_KEY=generate-me
NONCE_KEY=generate-me
AUTH_SALT=generate-me
SECURE_AUTH_SALT=generate-me
LOGGED_IN_SALT=generate-me
NONCE_SALT=generate-me
