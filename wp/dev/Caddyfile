
:80 {
	encode zstd br gzip
	try_files {path} {path}/index.php index.php
	root * {$CADDY_ROOT}
  	{$CADDY_SERVER_EXTRA_DIRECTIVES}
	@wp_api path /wp-json*
	header @wp_api {
		Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		Pragma "no-cache"
		Expires "0"
		-Etag
	}
	# WORKER MODE: FrankenPHP boots WordPress once and reuses the process.
	# Typically 3-10x faster for REST/API requests vs traditional php_server.
	#
	# ROLLBACK: if you see global state leaks, session bugs, or unexpected 500s,
	# remove the `worker` block below and restart the container.
	# Pre-worker config was: php_server { resolve_root_symlink false }
	php_server {
		resolve_root_symlink false
		worker {
			file /app/web/worker.php
			num 6
		}
	}
}