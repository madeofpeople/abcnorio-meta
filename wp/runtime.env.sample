COMPOSER_HOME=/tmp/composer
COMPOSER_CACHE_DIR=/tmp/composer/cache
STATIC_SERVER_SITE_DIR=/shared/static
ASTRO_BUILD_ARCHIVE_DIR=/container/path/to/build-archives
ASTRO_BUILD_TRIGGER_SECRET=your-shared-secret-token

# Shared WP container settings (loaded by both cms_dev and cms_staging)
SERVER_NAME=:80
DB_HOST=mariadb-service-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password
WORDPRESS_TABLE_PREFIX=wp_
TTL=80000
CADDY_ROOT=/app/web/

# Shared frontend URLs
# HEADLESS_FRONTEND_URL is set per-container via compose environment overrides (DEV_FRONTEND_URL / STAGING_FRONTEND_URL)
DEV_FRONTEND_URL=https://dev.your-domain.example
STAGING_FRONTEND_URL=https://staging.your-domain.example
